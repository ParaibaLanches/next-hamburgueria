generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  role      String    @default("cashier") @db.VarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders    Order[]
  closures  Closure[]
}

model Client {
  id           Int       @id @default(autoincrement())
  name         String?   @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  document     String?   @db.VarChar(50)
  phone        String?   @db.VarChar(50)
  address      String?   @db.Text
  cep          String?   @db.VarChar(10)
  street       String?   @db.VarChar(255)
  number       String?   @db.VarChar(20)
  neighborhood String?   @db.VarChar(100)
  city         String?   @db.VarChar(100)
  state        String?   @db.VarChar(50)
  complement   String?   @db.VarChar(255)
  avatarUrl    String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  customerOrders Order[]  @relation("CustomerOrders")
  clientOrders   Order[]  @relation("ClientOrders")
  coupons        Coupon[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products    Product[]
}

model Product {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(255)
  description      String?   @db.Text
  price            Decimal   @db.Decimal(10, 2)
  categoryId       Int
  category         Category  @relation(fields: [categoryId], references: [id])
  imageUrl         String?   @db.VarChar(500)
  isFeatured       Boolean   @default(false)
  featuredSlot     String?   @default("none") @db.VarChar(50)
  promotionLabel   String?   @default("") @db.VarChar(100)
  promotionalPrice Decimal?  @db.Decimal(10, 2)
  available        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  orderItems       OrderItem[]
}

model Order {
  id               Int       @id @default(autoincrement())
  userId           Int?
  user             User?     @relation(fields: [userId], references: [id])
  customerId       Int?
  customer         Client?   @relation("CustomerOrders", fields: [customerId], references: [id])
  clientId         Int?
  client           Client?   @relation("ClientOrders", fields: [clientId], references: [id])
  code             String    @db.VarChar(10)
  orderType        String    @db.VarChar(20)
  status           String    @default("pending") @db.VarChar(50)
  total            Decimal   @db.Decimal(10, 2)
  notes            String?   @db.Text
  closureId        Int?
  closure          Closure?  @relation(fields: [closureId], references: [id])
  couponId         Int?
  coupon           Coupon?   @relation(fields: [couponId], references: [id])
  deliveryFee      Decimal   @default(0) @db.Decimal(10, 2)
  deliveryDistance Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal   @default(0) @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  items            OrderItem[]
  payments         Payment[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes     String? @db.Text
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  method    String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model Closure {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  openingTime    DateTime
  closingTime    DateTime?
  initialBalance Decimal   @default(0) @db.Decimal(10, 2)
  finalBalance   Decimal?  @db.Decimal(10, 2)
  totalCash      Decimal   @default(0) @db.Decimal(10, 2)
  totalCredit    Decimal   @default(0) @db.Decimal(10, 2)
  totalDebit     Decimal   @default(0) @db.Decimal(10, 2)
  totalPix       Decimal   @default(0) @db.Decimal(10, 2)
  reportedCash   Decimal?  @db.Decimal(10, 2)
  reportedCredit Decimal?  @db.Decimal(10, 2)
  reportedDebit  Decimal?  @db.Decimal(10, 2)
  reportedPix    Decimal?  @db.Decimal(10, 2)
  withdrawals    Decimal?  @default(0) @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2)
  status         String    @default("open") @db.VarChar(20)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         Order[]
}

model Coupon {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(6)
  type           String    @db.VarChar(20)
  value          Decimal   @db.Decimal(10, 2)
  minPurchase    Decimal   @default(0) @db.Decimal(10, 2)
  usageLimit     Int       @default(0)
  usedCount      Int       @default(0)
  startsAt       DateTime  @default(now())
  expiresAt      DateTime
  isActive       Boolean   @default(true)
  clientId       Int?
  client         Client?   @relation(fields: [clientId], references: [id])
  distributionId Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  orders         Order[]
}
